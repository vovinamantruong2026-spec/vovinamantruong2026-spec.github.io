rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed() { return request.auth != null && request.auth.token.email is string; }
  function me() { return get(/databases/$(database)/documents/clubs/antruong-v2/members/$(request.auth.token.email.lower())).data; }
  function verified(a) { return request.auth.token.email_verified == true; }
  function maintenance() { return exists(/databases/$(database)/documents/clubs/antruong-v2/meta/maintenance) && get(/databases/$(database)/documents/clubs/antruong-v2/meta/maintenance).data.state != 'ready'; }
  function live(a) { return signed() && verified(a) && a.status == 'active' && (a.isSuperAdmin == true || (!maintenance() && get(/databases/$(database)/documents/clubs/antruong-v2/meta/import).data.status == 'ready')); }
  function active() { let a = me(); return live(a); }
  function owner() { let a = me(); return signed() && verified(a) && a.status == 'active' && a.isSuperAdmin == true; }
  function has(a,p) { return a.isSuperAdmin == true || a.permissions.get(p,false) == true; }
  function inClass(a,cid) { return a.isSuperAdmin == true || a.allClasses == true || cid in a.classIds; }
  function readRecord(r) {
   let a = me();
   return live(a) && (a.isSuperAdmin == true ||
    (r.kind == 'account' && r.id == a.id) || r.kind == 'config' ||
    (r.kind == 'class' && inClass(a,r.id)) ||
    (r.kind == 'student' && inClass(a,r.data.classId) && (has(a,'students_direct') || has(a,'attendance_manage') || has(a,'tuition_manage') || has(a,'reports_export') || has(a,'gear_manage') || has(a,'tournaments_manage') || has(a,'approvals_manage'))) ||
    (r.kind == 'attendance' && inClass(a,r.data.classId) && (has(a,'attendance_manage') || has(a,'reports_export'))) ||
    (r.kind == 'tuition' && inClass(a,r.data.classId) && has(a,'tuition_manage')) ||
    (r.kind == 'gear' && inClass(a,r.data.classId) && has(a,'gear_manage')) ||
    (r.kind == 'tournament' && inClass(a,r.data.classId) && has(a,'tournaments_manage')) ||
    (r.kind == 'approval' && inClass(a,r.data.classId) && has(a,'approvals_manage')));
  }
  function writeRecord(r) {
   let a = me();
   return !maintenance() && live(a) && (a.isSuperAdmin == true ||
    (r.kind == 'config' && has(a,'settings_manage')) ||
    (r.kind == 'class' && inClass(a,r.id) && has(a,'classes_manage')) ||
    (r.kind == 'student' && inClass(a,r.data.classId) && has(a,'students_direct')) ||
    (r.kind == 'attendance' && inClass(a,r.data.classId) && has(a,'attendance_manage')) ||
    (r.kind == 'tuition' && inClass(a,r.data.classId) && has(a,'tuition_manage')) ||
    (r.kind == 'gear' && inClass(a,r.data.classId) && has(a,'gear_manage')) ||
    (r.kind == 'tournament' && inClass(a,r.data.classId) && has(a,'tournaments_manage')) ||
    (r.kind == 'approval' && inClass(a,r.data.classId) && has(a,'approvals_manage')));
  }
  function reserved(r) { return r.kind != 'student' || getAfter(/databases/$(database)/documents/clubs/antruong-v2/studentCodes/$('code-' + r.data.id.lower())).data.studentUid == r.id; }
  function restoring() { return owner() && maintenance(); }
  function reviewScope(cid) { let a = me(); return live(a) && !maintenance() && inClass(a,cid) && has(a,'approvals_manage'); }
  function approvedStudentDeletion(r) {
   let before = resource.data;
   let ref = /databases/$(database)/documents/clubs/antruong-v2/deletionRequests/$(r.data.get('deletionRequestId','missing'));
   let old = get(ref).data;
   let decision = getAfter(ref).data;
   return r.kind == 'student' && reviewScope(before.data.classId) &&
    before.data.get('deleted',false) == false && r.data.deleted == true &&
    r.data.diff(before.data).affectedKeys().hasOnly(['deleted','deletedAt','deletedBy','deletionRequestId']) &&
    r.data.deletedBy == me().name && r.data.deletedAt is string &&
    old.status == 'pending' && old.studentUid == r.id && old.classId == before.data.classId && old.targetVersion == before.version &&
    decision.status == 'approved' && decision.reviewedBy == request.auth.uid && decision.reviewedAt == request.time;
  }
  function trashAllowed(r) { return (r.kind == 'student' && r.data.get('deleted',false) == true && (resource == null || resource.data.data.get('deleted',false) == false) ? (resource != null && approvedStudentDeletion(r)) : owner()) || (r.data.get('deleted',false) == false && (resource == null || resource.data.data.get('deleted',false) == false)); }
  function valid(r) {
   return r.keys().hasOnly(['kind','id','data','version','updatedAt','auditId','imported']) &&
    r.kind in ['student','class','attendance','tuition','gear','tournament','approval','config','account'] &&
    r.id is string && r.id.size() > 0 && r.id.size() < 250 && r.data is map &&
    !r.data.keys().hasAny(['password','passwordHash','secret','databaseSecret']) &&
    r.version is int && r.version > 0 && r.updatedAt == request.time &&
    (r.kind != 'student' || (r.data.name is string && r.data.name.size() > 0 && r.data.id is string && r.data.id.size() > 0 && r.data.id.size() <= 80 && r.data.id.matches('[^/]+') && r.data.classId is string)) &&
    (r.kind != 'class' || (r.data.name is string && r.data.name.size() > 0)) &&
    (r.kind != 'tuition' || (r.data.amount is number && r.data.amount >= 0 && r.data.status in ['paid','unpaid','discount'])) &&
    (r.kind != 'attendance' || (r.data.rows is list && r.data.rows.size() <= 1000 && r.data.status in ['draft','final']));
  }
  function hasAudit(r) {
   let event = getAfter(/databases/$(database)/documents/clubs/antruong-v2/audit/$(r.auditId)).data;
   return r.auditId is string && event.actorUid == request.auth.uid && event.kind == r.kind && event.record_id == r.id && event.at == request.time;
  }
  function purgingTrash(r,key) {
   let operation = getAfter(/databases/$(database)/documents/clubs/antruong-v2/meta/trashPurge).data;
   let event = getAfter(/databases/$(database)/documents/clubs/antruong-v2/audit/$(operation.auditId)).data;
   return owner() && !maintenance() && get(/databases/$(database)/documents/clubs/antruong-v2/meta/import).data.status == 'ready' &&
    r.data.get('deleted',false) == true && r.data.get('isSuperAdmin',false) == false &&
    r.kind in ['student','class','attendance','tuition','account','gear','tournament','approval'] &&
    operation.recordKey == key && operation.actorUid == request.auth.uid && operation.at == request.time &&
    event.actorUid == request.auth.uid && event.action == 'purge' && event.kind == r.kind && event.record_id == r.id && event.at == request.time;
  }
  match /clubs/antruong-v2/deletionRequests/{id} {
   function target() { return get(/databases/$(database)/documents/clubs/antruong-v2/records/$('student--' + request.resource.data.studentUid)).data; }
   allow get: if active() && (!exists(/databases/$(database)/documents/clubs/antruong-v2/deletionRequests/$(id)) || (inClass(me(),resource.data.classId) && (has(me(),'students_direct') || has(me(),'approvals_manage'))));
   allow list: if active() && inClass(me(),resource.data.classId) && (has(me(),'students_direct') || has(me(),'approvals_manage'));
   allow create: if active() && !maintenance() && has(me(),'students_direct') && inClass(me(),request.resource.data.classId) &&
    request.resource.data.keys().hasOnly(['studentUid','studentName','classId','targetVersion','requestedBy','requesterName','status','createdAt']) &&
    request.resource.data.studentUid is string && request.resource.data.targetVersion is int &&
    id == request.resource.data.studentUid + '_' + string(request.resource.data.targetVersion) &&
    request.resource.data.status == 'pending' && request.resource.data.requestedBy == request.auth.uid &&
    request.resource.data.requesterName == me().name && request.resource.data.createdAt == request.time &&
    target().kind == 'student' && target().data.get('deleted',false) == false &&
    target().data.classId == request.resource.data.classId && target().data.name == request.resource.data.studentName && target().version == request.resource.data.targetVersion;
   allow update: if reviewScope(resource.data.classId) && resource.data.status == 'pending' &&
    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedBy','reviewerName','reviewedAt']) &&
    request.resource.data.status in ['approved','rejected'] && request.resource.data.reviewedBy == request.auth.uid &&
    request.resource.data.reviewerName == me().name && request.resource.data.reviewedAt == request.time &&
    (request.resource.data.status == 'rejected' || (
     getAfter(/databases/$(database)/documents/clubs/antruong-v2/records/$('student--' + resource.data.studentUid)).data.data.deleted == true &&
     getAfter(/databases/$(database)/documents/clubs/antruong-v2/records/$('student--' + resource.data.studentUid)).data.data.deletionRequestId == id &&
     getAfter(/databases/$(database)/documents/clubs/antruong-v2/records/$('student--' + resource.data.studentUid)).data.version == resource.data.targetVersion + 1));
   allow delete: if false;
  }
  match /clubs/antruong-v2/members/{email} {
   allow get: if signed() && (email == request.auth.token.email.lower() || owner());
   allow list: if owner();
   allow create, update: if owner() && (!exists(/databases/$(database)/documents/clubs/antruong-v2/members/$(email)) || resource.data.isSuperAdmin != true) && request.resource.data.keys().hasOnly(['id','name','email','status','isSuperAdmin','allClasses','classIds','permissions','roleTitle','requireEmailVerification']) &&
     request.resource.data.email == email && request.resource.data.status in ['active','inactive'] &&
     request.resource.data.isSuperAdmin == false && request.resource.data.allClasses is bool &&
     request.resource.data.classIds is list && request.resource.data.permissions is map;
   allow delete: if owner() && resource.data.isSuperAdmin != true;
  }
  match /clubs/antruong-v2/records/{key} {
   allow get: if active() && (!exists(/databases/$(database)/documents/clubs/antruong-v2/records/$(key)) || readRecord(resource.data));
   allow list: if owner() || readRecord(resource.data);
   allow create: if key == request.resource.data.kind + '--' + request.resource.data.id && valid(request.resource.data) && writeRecord(request.resource.data) && trashAllowed(request.resource.data) && (reserved(request.resource.data) || (owner() && request.resource.data.get('imported',false) == true && !exists(/databases/$(database)/documents/clubs/antruong-v2/meta/studentCodes))) && request.resource.data.version == 1 && ((owner() && request.resource.data.get('imported',false) == true) || hasAudit(request.resource.data));
   allow update: if resource.data.kind == 'student' && request.resource.data.data.get('deleted',false) == true && resource.data.data.get('deleted',false) == false && approvedStudentDeletion(request.resource.data) && valid(request.resource.data) && request.resource.data.kind == resource.data.kind && request.resource.data.id == resource.data.id && request.resource.data.version == resource.data.version + 1 && hasAudit(request.resource.data);
   allow update: if !(resource.data.kind == 'student' && request.resource.data.data.get('deleted',false) == true && resource.data.data.get('deleted',false) == false) && key == request.resource.data.kind + '--' + request.resource.data.id && valid(request.resource.data) && writeRecord(resource.data) && writeRecord(request.resource.data) && trashAllowed(request.resource.data) && !(resource.data.kind == 'account' && resource.data.data.get('isSuperAdmin',false) == true) && reserved(request.resource.data) && request.resource.data.id == resource.data.id && request.resource.data.kind == resource.data.kind && request.resource.data.version == resource.data.version + 1 && hasAudit(request.resource.data);
   allow create,update: if restoring() && valid(request.resource.data) && key == request.resource.data.kind + '--' + request.resource.data.id;
   allow delete: if restoring() || purgingTrash(resource.data,key);
  }
  match /clubs/antruong-v2/audit/{id} {
   allow read: if owner();
   allow create: if active() && request.resource.data.keys().hasOnly(['actor','actorUid','action','kind','record_id','at']) && request.resource.data.actorUid == request.auth.uid && request.resource.data.actor == me().name && request.resource.data.at == request.time;
   allow update,delete: if false;
  }
  match /clubs/antruong-v2/studentCodes/{code} {
   allow get: if active();
   allow list: if owner();
   allow create,update: if active() && request.resource.data.keys().hasOnly(['studentUid']) && request.resource.data.studentUid is string &&
    getAfter(/databases/$(database)/documents/clubs/antruong-v2/records/$('student--' + request.resource.data.studentUid)).data.data.id.lower() == code.replace('^code-','') &&
    (restoring() || (!maintenance() && writeRecord(getAfter(/databases/$(database)/documents/clubs/antruong-v2/records/$('student--' + request.resource.data.studentUid)).data) && (!exists(/databases/$(database)/documents/clubs/antruong-v2/studentCodes/$(code)) || resource.data.studentUid == request.resource.data.studentUid)));
   allow delete: if restoring() || (active() && !maintenance() && writeRecord(getAfter(/databases/$(database)/documents/clubs/antruong-v2/records/$('student--' + resource.data.studentUid)).data) && 'code-' + getAfter(/databases/$(database)/documents/clubs/antruong-v2/records/$('student--' + resource.data.studentUid)).data.data.id.lower() != code);
  }
  match /clubs/antruong-v2/recovery/{id} { allow read,write: if owner(); }
  match /clubs/antruong-v2/recovery/{id}/chunks/{chunk} { allow read,write: if owner(); }
  match /clubs/antruong-v2/backupTrash/{id} { allow read: if owner(); allow write: if false; }
  match /clubs/antruong-v2/weeklyBackups/{id} { allow read: if owner(); allow write: if false; }
  match /clubs/antruong-v2/profiles/{uid} {
   allow get,list: if active();
   allow delete: if restoring();
   allow create,update: if (restoring() || (active() && request.auth.uid == uid)) &&
    request.resource.data.keys().hasAll(['photoURL','updatedAt']) &&
    request.resource.data.keys().hasOnly(['photoURL','updatedAt','email','accountId','fullName','dob','phone','belt']) &&
    (restoring() || !request.resource.data.keys().hasAny(['email','accountId']) || (request.resource.data.email == request.auth.token.email.lower() && request.resource.data.accountId == me().id)) &&
    request.resource.data.get('fullName','') is string && request.resource.data.get('fullName','').size() <= 120 &&
    request.resource.data.get('dob','') is string && (request.resource.data.get('dob','') == '' || request.resource.data.dob.matches('(19|20)[0-9]{2}-[0-9]{2}-[0-9]{2}')) &&
    request.resource.data.get('phone','') is string && (request.resource.data.get('phone','') == '' || request.resource.data.phone.matches('[+0-9 ().-]{3,30}')) &&
    request.resource.data.get('belt','') is string && request.resource.data.get('belt','').size() <= 80 &&
    request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 180000 &&
    (request.resource.data.photoURL == '' || request.resource.data.photoURL.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+')) &&
    request.resource.data.updatedAt == request.time;
  }
  match /clubs/antruong-v2/meta/{id} { allow read: if owner() || (signed() && verified(me()) && me().status == 'active' && id in ['studentCodes','maintenance']); allow write: if owner(); }
  match /clubs/antruong-v2/snapshots/{id} { allow read,create,delete: if owner(); allow update: if false; }
 }
}
