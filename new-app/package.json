{
  "name": "vovinam-antruong-v2",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4173",
    "build": "tsc --noEmit && vite build",
    "test": "node tests/rules.mjs",
    "test:flows": "esbuild tests/flows.mjs --bundle --format=esm --platform=node --packages=external --outfile=tests/.flows-built.mjs && node tests/.flows-built.mjs",
    "test:recovery:build": "esbuild tests/recovery.mjs --bundle --format=esm --platform=node --packages=external --outfile=tests/.recovery-built.mjs",
    "test:idle": "node tests/idle.mjs",
    "test:reports": "esbuild tests/reports.mjs --bundle --format=esm --platform=node --packages=external --outfile=tests/.reports-built.mjs && node tests/.reports-built.mjs",
    "test:sync:build": "node tests/sync/build.mjs",
    "test:students": "esbuild tests/vovinam.mjs --bundle --format=esm --platform=node --outfile=tests/.vovinam-built.mjs && node tests/.vovinam-built.mjs",
    "test:student-policy": "esbuild tests/student-policy.mjs --bundle --format=esm --platform=node --outfile=tests/.student-policy-built.mjs && node tests/.student-policy-built.mjs && node tests/student-gateway.mjs",
    "test:student-files": "node tests/student-duplicates.mjs && node --test functions/student-files.test.js",
    "build:pages": "npm run build && node scripts/publish-pages.mjs",
    "test:student-files:ui": "node tests/student-files-ui.mjs",
    "test:operations": "esbuild tests/operations.mjs --bundle --format=esm --platform=node --packages=external --outfile=tests/.operations-built.mjs && node tests/.operations-built.mjs"
  },
  "dependencies": {
    "firebase": "^12.0.0",
    "jszip": "3.10.1",
    "lucide-react": "^1.31.0",
    "pdf-lib": "^1.17.1",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "^1.56.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
